{
  // Basic type checking of the widget front ends (plain browser JS, served as-is; nothing is emitted).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false, // TypeScript 7 defaults to strict; the widgets are checked at the basic level
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true
  },
  // Every widget's scripts (widget.js, mount.js, and the shared chart.js and presets.js), and the web dashboards page.
  "include": ["types/widgets.d.ts", "widgets/*/public/*.js", "settings/dashboard.js"]
}
