{
  "id": "com.thomassidor.widgetkeeper",
  "version": "1.1.0",
  "compatibility": ">=12.6.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Widgetkeeper",
    "nl": "Widgetkeeper",
    "de": "Widgetkeeper",
    "fr": "Widgetkeeper",
    "it": "Widgetkeeper",
    "sv": "Widgetkeeper",
    "no": "Widgetkeeper",
    "es": "Widgetkeeper",
    "da": "Widgetkeeper",
    "ru": "Widgetkeeper",
    "pl": "Widgetkeeper",
    "ko": "Widgetkeeper",
    "ar": "Widgetkeeper"
  },
  "description": {
    "en": "Custom widgets and dashboards in your browser",
    "nl": "Aangepaste widgets en dashboards in je browser",
    "de": "Eigene Widgets und Dashboards in deinem Browser",
    "fr": "Des widgets personnalisés et des tableaux de bord dans votre navigateur",
    "it": "Widget personalizzati e dashboard nel tuo browser",
    "sv": "Anpassade widgets och instrumentpaneler i din webbläsare",
    "no": "Egne widgeter og dashbord i nettleseren din",
    "es": "Widgets personalizados y paneles en tu navegador",
    "da": "Egne widgets og dashboards i din browser",
    "ru": "Собственные виджеты и панели в вашем браузере",
    "pl": "Własne widżety i pulpity w Twojej przeglądarce",
    "ko": "맞춤형 위젯과 브라우저 속 대시보드",
    "ar": "أدوات مخصصة ولوحات تحكم في متصفحك"
  },
  "category": [
    "tools"
  ],
  "brandColor": "#2A1958",
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Thomas Sidor",
    "email": "mail@thomassidor.com"
  },
  "source": "https://github.com/thomassidor/widgetkeeper",
  "bugs": {
    "url": "https://github.com/thomassidor/widgetkeeper/issues"
  },
  "homeyCommunityTopicId": 160453,
  "api": {
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "getVariablesKey": {
      "method": "GET",
      "path": "/variables-key"
    },
    "putVariablesKey": {
      "method": "PUT",
      "path": "/variables-key"
    },
    "getWebSetup": {
      "method": "GET",
      "path": "/web/setup"
    },
    "getWebDevices": {
      "method": "GET",
      "path": "/web/devices"
    },
    "getWebValues": {
      "method": "GET",
      "path": "/web/values"
    },
    "postWebAutocomplete": {
      "method": "POST",
      "path": "/web/autocomplete"
    },
    "putWebDashboard": {
      "method": "PUT",
      "path": "/web/dashboards"
    },
    "putWebFront": {
      "method": "PUT",
      "path": "/web/front"
    },
    "deleteWebDashboard": {
      "method": "DELETE",
      "path": "/web/dashboards/:id"
    },
    "postWebDashboardCopy": {
      "method": "POST",
      "path": "/web/dashboards/:id/copy"
    },
    "getWebBackup": {
      "method": "GET",
      "path": "/web/backup"
    },
    "putWebBackup": {
      "method": "PUT",
      "path": "/web/backup"
    },
    "postWebCall": {
      "method": "POST",
      "path": "/web/call"
    },
    "getWebAddress": {
      "method": "GET",
      "path": "/web/address"
    },
    "getKeypadCodes": {
      "method": "GET",
      "path": "/keypad-codes"
    },
    "postKeypadCode": {
      "method": "POST",
      "path": "/keypad-codes"
    },
    "putKeypadCode": {
      "method": "PUT",
      "path": "/keypad-codes/:id"
    },
    "deleteKeypadCode": {
      "method": "DELETE",
      "path": "/keypad-codes/:id"
    },
    "getWebPassword": {
      "method": "GET",
      "path": "/web/password"
    },
    "putWebPassword": {
      "method": "PUT",
      "path": "/web/password"
    },
    "postWebLogin": {
      "method": "POST",
      "path": "/web/login"
    },
    "postWebLogout": {
      "method": "POST",
      "path": "/web/logout"
    },
    "getWebPopups": {
      "method": "GET",
      "path": "/web/popups"
    },
    "getWebPopupImage": {
      "method": "GET",
      "path": "/web/popups/:id/image"
    },
    "postWebPopupAnswer": {
      "method": "POST",
      "path": "/web/popups/:id/answer"
    },
    "postPopup": {
      "method": "POST",
      "path": "/popup/:id",
      "public": true
    },
    "postPopupImage": {
      "method": "POST",
      "path": "/popup/:id/image",
      "public": true
    },
    "postPopupAnswer": {
      "method": "POST",
      "path": "/popup/:id/answer",
      "public": true
    }
  }
}
