{
  "id": "com.thomassidor.widgetkeeper",
  "version": "1.0.0",
  "compatibility": ">=12.6.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Widgetkeeper",
    "nl": "Widgetkeeper",
    "de": "Widgetkeeper",
    "fr": "Widgetkeeper",
    "it": "Widgetkeeper",
    "sv": "Widgetkeeper",
    "no": "Widgetkeeper",
    "es": "Widgetkeeper",
    "da": "Widgetkeeper",
    "ru": "Widgetkeeper",
    "pl": "Widgetkeeper",
    "ko": "Widgetkeeper",
    "ar": "Widgetkeeper"
  },
  "description": {
    "en": "Custom dashboard widgets for your Homey.",
    "nl": "Aangepaste dashboardwidgets voor je Homey.",
    "de": "Eigene Dashboard-Widgets für dein Homey.",
    "fr": "Des widgets de tableau de bord personnalisés pour votre Homey.",
    "it": "Widget personalizzati per la dashboard del tuo Homey.",
    "sv": "Anpassade widgets för instrumentpanelen i din Homey.",
    "no": "Egne dashbord-widgeter for din Homey.",
    "es": "Widgets personalizados para el panel de tu Homey.",
    "da": "Egne dashboard-widgets til din Homey.",
    "ru": "Пользовательские виджеты панели для вашего Homey.",
    "pl": "Własne widżety pulpitu dla Twojego Homey.",
    "ko": "Homey를 위한 맞춤형 대시보드 위젯.",
    "ar": "أدوات مخصصة للوحة التحكم في Homey."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#2A1958",
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Thomas Sidor",
    "email": "mail@thomassidor.com"
  },
  "source": "https://github.com/thomassidor/widgetkeeper",
  "bugs": {
    "url": "https://github.com/thomassidor/widgetkeeper/issues"
  },
  "homeyCommunityTopicId": 160453,
  "api": {
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "getVariablesKey": {
      "method": "GET",
      "path": "/variables-key"
    },
    "putVariablesKey": {
      "method": "PUT",
      "path": "/variables-key"
    },
    "getWebSetup": {
      "method": "GET",
      "path": "/web/setup"
    },
    "getWebDevices": {
      "method": "GET",
      "path": "/web/devices"
    },
    "getWebValues": {
      "method": "GET",
      "path": "/web/values"
    },
    "postWebAutocomplete": {
      "method": "POST",
      "path": "/web/autocomplete"
    },
    "putWebDashboard": {
      "method": "PUT",
      "path": "/web/dashboards"
    },
    "putWebFront": {
      "method": "PUT",
      "path": "/web/front"
    },
    "deleteWebDashboard": {
      "method": "DELETE",
      "path": "/web/dashboards/:id"
    },
    "postWebDashboardCopy": {
      "method": "POST",
      "path": "/web/dashboards/:id/copy"
    },
    "getWebBackup": {
      "method": "GET",
      "path": "/web/backup"
    },
    "putWebBackup": {
      "method": "PUT",
      "path": "/web/backup"
    },
    "postWebCall": {
      "method": "POST",
      "path": "/web/call"
    },
    "getWebAddress": {
      "method": "GET",
      "path": "/web/address"
    },
    "getWebPassword": {
      "method": "GET",
      "path": "/web/password"
    },
    "putWebPassword": {
      "method": "PUT",
      "path": "/web/password"
    },
    "postWebLogin": {
      "method": "POST",
      "path": "/web/login"
    },
    "postWebLogout": {
      "method": "POST",
      "path": "/web/logout"
    }
  }
}
